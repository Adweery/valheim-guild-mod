<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ValheimGuildTelemetry</AssemblyName>
    <Version>1.3.3</Version>
    <GameReferences Condition="'$(GameReferences)' == ''">../../../../work/server-inspection</GameReferences>
    <LoaderReferences Condition="'$(LoaderReferences)' == ''">../../../../work/mod-build/bepinex/BepInExPack_Valheim/BepInEx/core</LoaderReferences>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(LoaderReferences)/BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(LoaderReferences)/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="assembly_valheim"><HintPath>$(GameReferences)/assembly_valheim.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="assembly_guiutils"><HintPath>$(GameReferences)/assembly_guiutils.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="assembly_utils"><HintPath>$(GameReferences)/assembly_utils.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(GameReferences)/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameReferences)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>

    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(GameReferences)/UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(GameReferences)/UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(GameReferences)/UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
<ItemGroup><EmbeddedResource Include="translations.json" LogicalName="ValheimGuildTelemetry.translations.json" /></ItemGroup></Project>
